{
  "name": "@askalf/plumbline",
  "version": "0.1.0",
  "description": "trajectory-level monitoring for autonomous agents — scores an action sequence against its declared intent, catching escapes composed entirely of individually-authorized steps. Part of Own Your Stack.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./src/schema.mjs",
    "./envelope": "./src/envelope.mjs",
    "./score": "./src/score.mjs",
    "./detect": "./src/detect/index.mjs",
    "./reachability": "./src/reachability.mjs",
    "./semantic": "./src/semantic.mjs",
    "./judges/ollama": "./src/judges/ollama.mjs"
  },
  "bin": {
    "plumbline": "src/cli.mjs"
  },
  "files": [
    "src/",
    "schema/",
    "profiles/",
    "corpus/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "replay": "node src/cli.mjs replay corpus/exploitgym.jsonl",
    "replay:benign": "node src/cli.mjs replay corpus/benign-repo-triage.jsonl"
  },
  "keywords": [
    "ai-security",
    "agent-security",
    "trajectory",
    "observability",
    "llm-agents",
    "sandbox-escape",
    "own-your-stack"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askalf/plumbline.git"
  },
  "homepage": "https://github.com/askalf/plumbline#readme",
  "bugs": {
    "url": "https://github.com/askalf/plumbline/issues"
  }
}
